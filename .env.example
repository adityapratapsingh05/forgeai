# ForgeAI LLM Configuration (Gemini OpenAI-compatible API; no Ollama required)
# Gemini is used for chat; FastEmbed creates document/query vectors locally.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.1-flash-lite
LLM_API_KEY=replace-with-your-gemini-api-key
EMBED_MODEL=local:sentence-transformers/all-MiniLM-L6-v2

# Optional separate judge model (defaults to LLM_MODEL if blank)
JUDGE_MODEL=

# Reliability & caching
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
FORGEAI_CACHE_DIR=.forgeai_cache
